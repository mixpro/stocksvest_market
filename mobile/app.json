{
  "expo": {
    "name": "StocksVest",
    "slug": "stocksvest-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-light.png",
    "scheme": "stocksvest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.stocksvest.trader",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Confirm Kill all and other trades with Face ID.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon-dark.png"
      }
    },
    "android": {
      "package": "com.stocksvest.trader",
      "adaptiveIcon": {
        "backgroundColor": "#4A3FE0",
        "foregroundImage": "./assets/images/icon-light.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-light.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5FB",
          "dark": {
            "backgroundColor": "#0E0F1E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "de1f0ec1-23ec-4741-be83-43ff54cc8a1b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/de1f0ec1-23ec-4741-be83-43ff54cc8a1b"
    }
  }
}
