{
  "expo": {
    "name": "StocksVest",
    "slug": "stocksvest-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stocksvest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.stocksvest.trader",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Confirm Kill all and other trades with Face ID.",
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true }
      }
    },
    "android": {
      "package": "com.stocksvest.trader",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5FB",
          "dark": { "backgroundColor": "#0E0F1E" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
