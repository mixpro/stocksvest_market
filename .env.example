# Alpaca Trading API keys (paper account is fine; used for market data only)
ALPACA_KEY=
ALPACA_SECRET=
# Real-money account (production host only): its broker account uses credentialsRef ALPACA_LIVE; 1 unlocks LIVE
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALLOW_LIVE=
# Pause a portfolio's buy automations this far (%) below its peak; 0 = off (docs/LIVE-RULES.md)
KILL_DRAWDOWN_PERCENT=30

# Keys third-party apps send in the X-API-Key header (comma separated)
API_KEYS=
# Key for /admin endpoints (halal DB upload, manual sync)
ADMIN_KEY=

# SEC EDGAR contact for sector data, e.g. "StocksVest-Market you@example.com" (empty = no sectors)
SEC_USER_AGENT=

# Optional
# DATA_DIR=data
# SYNC_INTERVAL_MINUTES=1
# SIP_DELAY_MINUTES=0         # paid Alpaca data plan; 16 on the free plan (with ALPACA_RPM=180)
# OTHER_EXCHANGES=N           # otherlisted.txt exchange codes to include (N = NYSE, A = NYSE American)
# DAILY_HISTORY_DAYS=730
# HOURLY_HISTORY_DAYS=730
# MINUTE_HISTORY_DAYS=7
# RUN_SCHEDULER=true
# LOG_LEVEL=INFO

# Grafana admin login (user: admin), used by docker compose
GRAFANA_ADMIN_PASSWORD=

# App service (filters): keys clients and the sample UI send in X-API-Key, and the key it uses for the market API
APP_API_KEYS=
MARKET_API_KEY=
# RUN_RETENTION_DAYS=183
# APP_RUN_SCHEDULER=true       # background scheduler for automations
# SCHEDULER_TICK_SECONDS=30
