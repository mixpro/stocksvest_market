classDiagram
  class Watcher {
    <<interface>>
    - name: string
    - every: timedelta
    - hours: WatcherHours
    + check(ctx, conn, now, state) List~Event~
  }

  class WatcherHours {
    <<enumeration>>
    REGULAR
    EXTENDED
    ALWAYS
  }

  class NewsWatcher {
    + check(ctx, conn, now, state) List~Event~
  }
  class FilingsWatcher {
    + check(ctx, conn, now, state) List~Event~
  }
  class EarningsWatcher {
    + check(ctx, conn, now, state) List~Event~
  }
  class MarketWatcher {
    + check(ctx, conn, now, state) List~Event~
  }
  class HoldingsDropWatcher {
    + check(ctx, conn, now, state) List~Event~
  }

  class WatcherConfig {
    - name: string
    - enabled: bool
    - settings: dict
    - state: dict
    - lastRunAt: datetime?
    - lastError: string?
  }

  class WatcherThread {
    - registry: dict~string, Watcher~
    + start()
    + stop()
    - tick(now)
  }

  class Event {
    - id: string
    - key: string
    - watcher: string
    - kind: EventKind
    - symbolId: string?
    - sector: string?
    - severity: int
    - at: datetime
    - eventDate: datetime?
    - data: dict
    - source: EventSource?
    - status: EventStatus
    - statusReason: string?
    - automationId: string?
    - createdAt: datetime
  }

  class EventSource {
    - url: string
    - publishedAt: datetime
    - quote: string?
    - rawText: string
    - modelAnswer: dict?
  }

  class EventKind {
    <<enumeration>>
    TRIAL_READOUT
    FDA_DECISION
    FDA_ADVISORY
    EARNINGS
    SHARE_OFFERING
    GOING_CONCERN
    HOLDING_DROP
    MARKET_DROP
    SECTOR_DROP
    OTHER_NEWS
  }

  class EventStatus {
    <<enumeration>>
    NEW
    IGNORED
    SUPPRESSED
    AWAITING_CONFIRM
    ACTING
    DONE
    FAILED
    DECLINED
    EXPIRED
  }

  class Dispatcher {
    - cursor: int
    + dispatch(conn)
    + confirm(eventId, yes)
  }

  class EventTrigger {
    - watchers: List~string~
    - kinds: List~EventKind~
    - minSeverity: int
    - heldOnly: bool
    - cooldown: timedelta
    - maxPerDay: int
    - confirmLive: bool
    - confirmWithin: timedelta
    - maxPriceMovePercent: Decimal
  }

  class Automation {
    - triggers: SCHEDULE or EVENT
  }

  Watcher <|.. NewsWatcher
  Watcher <|.. FilingsWatcher
  Watcher <|.. EarningsWatcher
  Watcher <|.. MarketWatcher
  Watcher <|.. HoldingsDropWatcher
  Watcher "1" --> "1" WatcherHours
  WatcherThread "1" o-- "*" Watcher : runs
  WatcherThread "1" --> "*" WatcherConfig : reads, saves state
  Watcher ..> Event : returns
  Event "1" --> "1" EventKind
  Event "1" --> "1" EventStatus
  Event "1" *-- "0..1" EventSource
  Dispatcher "1" --> "*" Event : reads NEW, sets status
  Dispatcher "1" --> "*" Automation : finds matching
  Automation "1" *-- "*" EventTrigger

  note for Watcher "A watcher only detects: it returns events and never places orders.\nAdding one = one file + one line in the WATCHERS registry.\nstate is saved for it between passes (e.g. the last news id seen)."
  note for Event "key is unique (e.g. catalyst:IOVA:2026-10-29, drop:INTC:2026-10-30): the same finding never fires twice.\nseverity 1..5. source keeps the text the model read and its answer, for the history and for replay tests."
  note for EventTrigger "A new trigger type for automations (Automations.mmd), next to schedules, so rules reuse the existing actions, budgets, kill rule and run history.\nLIVE trades wait for a confirm on the phone; EXPIRED when not confirmed within confirmWithin or the price moved more than maxPriceMovePercent."
