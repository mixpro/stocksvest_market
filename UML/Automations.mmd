classDiagram
  %% ------------------------------------------------------------------ definition

  class Automation {
    - id: string
    - name: string
    - description: string
    - createdAt: datetime
    - updatedAt: datetime
    - status: AutomationStatus
    - configVersion: int
    - runTargets: List~FilterRunTarget~
    - schedules: List~Schedule~
    - actions: List~AutomationAction~
    - orderGuards: OrderGuards?
    + budgets() List~Budget~
    + record() AutomationRecord
  }

  class AutomationStatus {
    <<enumeration>>
    ACTIVE
    PAUSED
  }

  class AutomationSwitch {
    - automationsEnabled: bool
    - changedAt: datetime
    - reason: string?
  }

  class FilterRunTargetType {
    <<enumeration>>
    FILTER
    FILTER_GROUP
  }

  class FilterRunTarget {
    - id: string
    - type: FilterRunTargetType
  }

  class AutomationAction {
    <<abstract>>
    + execute(context: RunContext) ActionResult
  }

  class NotifyAction {
    - title: string
    - message: string
    - includeMatchedSymbols: bool
  }

  class AddToWatchlistAction {
    - watchlistId: string
  }

  class PlaceOrderAction {
    - side: OrderSide
    - orderType: OrderType
    - timeInForce: TimeInForce
    - limitOffsetPercent: Decimal?
    - stopOffsetPercent: Decimal?
    - trailPercent: Decimal?
    - extendedHours: bool
    - selection: SymbolSelection
    - sizings: List~OrderSizing~
  }

  class SymbolSelection {
    - mode: SelectionMode
    - topN: int?
    - rankBy: RankingKey?
    - descending: bool
  }

  class SelectionMode {
    <<enumeration>>
    ALL_MATCHES
    TOP_N
  }

  class RankingKey {
    <<enumeration>>
    LAST_PRICE
    DAILY_CHANGE_PERCENT
    DAILY_VOLUME
    POSITION_VALUE
    UNREALIZED_PNL_PERCENT
  }

  class OrderSizing {
    - mode: OrderSizingMode
    - value: Decimal
  }

  class OrderSizingMode {
    <<enumeration>>
    QUANTITY
    CASH_AMOUNT
    PERCENT_OF_BUDGET
    PERCENT_OF_POSITION
  }

  class OrderGuards {
    - maxOrdersPerRun: int?
    - maxPositionValue: Decimal?
    - maxPositionPercent: Decimal?
    - regularHoursOnly: bool
    - skipBuyIfHeld: bool
    - maxDataAgeMinutes: int
  }

  %% ------------------------------------------------------------------ budgets (chosen by the portfolio)

  class Budget {
    - id: string
    - portfolioId: string
    - name: string
    - currency: string
    - allocated: Decimal
    - cash: Decimal
    - reserved: Decimal
    - invested: Decimal
    - realizedPnL: Decimal
    - fees: Decimal
    + available() Decimal
  }

  class BudgetAutomation {
    - budgetId: string
    - automationId: string
    - addedAt: datetime
  }

  class AutomationRecord {
    - budgetId: string
    - ordersPlaced: int
    - openOrders: int
    - buyFills: int
    - spent: Decimal
    - sellFills: int
    - received: Decimal
    - realizedPnL: Decimal
    - fees: Decimal
  }

  class BudgetEntry {
    - id: string
    - budgetId: string
    - automationId: string?
    - type: BudgetEntryType
    - amount: Decimal
    - cashAfter: Decimal
    - reservedAfter: Decimal
    - runId: string?
    - orderId: string?
    - fillId: string?
    - note: string?
    - createdAt: datetime
  }

  class BudgetEntryType {
    <<enumeration>>
    ALLOCATE
    WITHDRAW
    RESERVE
    RELEASE
    BUY_FILL
    SELL_FILL
    FEE
    ADJUSTMENT
  }

  %% ------------------------------------------------------------------ scheduling state

  class ScheduleState {
    - scheduleId: string
    - lastFiredFor: datetime?
    - nextFireAt: datetime?
  }

  class ScheduleFire {
    - id: string
    - automationId: string
    - scheduleId: string
    - scheduledFor: datetime
    - firedAt: datetime
    - runId: string
  }

  %% ------------------------------------------------------------------ history

  class AutomationRun {
    - id: string
    - automationId: string
    - trigger: RunTrigger
    - scheduleFireId: string?
    - configVersion: int
    - definition: json
    - startedAt: datetime
    - finishedAt: datetime?
    - status: RunStatus
    - skipReason: RunSkipReason?
    - market: MarketContext
    - budgets: List~RunBudget~
    - targets: List~TargetResult~
    - matched: List~MatchedSymbol~
    - actions: List~ActionResult~
    - metrics: RunMetrics
    - errors: List~string~
  }

  class RunTrigger {
    <<enumeration>>
    SCHEDULE
    MANUAL
  }

  class RunStatus {
    <<enumeration>>
    RUNNING
    SUCCEEDED
    PARTIAL
    FAILED
    SKIPPED
  }

  class RunSkipReason {
    <<enumeration>>
    OVERLAP
    PAUSED
    SWITCH_OFF
    MISSED
  }

  class MarketContext {
    - session: MarketSession
    - marketLastSyncAt: datetime?
    - dataAgeMinutes: int?
  }

  class MarketSession {
    <<enumeration>>
    PRE_MARKET
    REGULAR
    AFTER_HOURS
    CLOSED
  }

  class RunBudget {
    - budgetId: string
    - name: string
    - portfolioId: string
    - brokerAccountId: string?
    - environment: BrokerEnvironment?
    - before: BudgetSnapshot?
    - after: BudgetSnapshot?
    - error: string?
  }

  class BudgetSnapshot {
    - cash: Decimal
    - reserved: Decimal
    - invested: Decimal
    - positionsValue: Decimal
    - equity: Decimal
  }

  class TargetResult {
    - targetId: string
    - type: FilterRunTargetType
    - steps: List~StepCount~
    - count: int
  }

  class MatchedSymbol {
    - ticker: string
    - symbolId: string
    - price: Decimal?
    - priceTime: datetime?
    - dailyChangePercent: Decimal?
    - heldQuantity: Decimal
  }

  class ActionResult {
    - index: int
    - type: string
    - status: RunStatus
    - budgets: List~ActionBudgetResult~
    - detail: string?
    - notificationId: string?
    - addedSymbols: List~string~
    - error: string?
  }

  class ActionBudgetResult {
    - budgetId: string
    - name: string
    - status: RunStatus
    - notHeld: int
    - intents: List~OrderIntent~
    - error: string?
  }

  class OrderIntent {
    - ticker: string
    - side: OrderSide
    - rank: int?
    - sizing: OrderSizing
    - quantity: Decimal
    - estimatedPrice: Decimal?
    - estimatedCost: Decimal?
    - limitPrice: Decimal?
    - stopPrice: Decimal?
    - decision: IntentDecision
    - skipReason: SkipReason?
    - orderId: string?
  }

  class IntentDecision {
    <<enumeration>>
    PLACE
    SKIP
    FAILED
  }

  class SkipReason {
    <<enumeration>>
    ALREADY_HELD
    NOT_HELD
    INSUFFICIENT_BUDGET
    MAX_ORDERS_REACHED
    MAX_POSITION
    OUTSIDE_REGULAR_HOURS
    NO_PRICE
    ZERO_QUANTITY
    STALE_DATA
    NOT_SUPPORTED_BY_BROKER
  }

  class RunMetrics {
    - durationMs: int
    - matchedCount: int
    - intentCount: int
    - placedCount: int
    - skippedCount: int
    - failedCount: int
    - estimatedBuyCost: Decimal
    - estimatedSellProceeds: Decimal
  }

  class AutomationEvent {
    - id: string
    - automationId: string
    - type: AutomationEventType
    - configVersion: int
    - changes: json
    - createdAt: datetime
  }

  class AutomationEventType {
    <<enumeration>>
    CREATED
    UPDATED
    PAUSED
    RESUMED
    BUDGET_ADDED
    BUDGET_REMOVED
    DELETED
  }

  class PerformanceSnapshot {
    - budgetId: string
    - date: Date
    - cash: Decimal
    - reserved: Decimal
    - invested: Decimal
    - positionsValue: Decimal
    - equity: Decimal
    - realizedPnL: Decimal
    - unrealizedPnL: Decimal
    - fees: Decimal
    - returnPercent: Decimal
    - openPositions: int
    - ordersPlaced: int
    - fills: int
  }

  class Notification {
    - id: string
    - automationId: string
    - runId: string
    - title: string
    - message: string
    - symbols: List~string~
    - createdAt: datetime
    - readAt: datetime?
  }

  %% ------------------------------------------------------------------ other files

  class InvestmentPortfolio {
    <<from InvestmentPortfolio.mmd>>
  }

  class PositionLot {
    <<from InvestmentPortfolio.mmd>>
  }

  class Schedule {
    <<from Scheduling.mmd>>
  }

  class Filter {
    <<from FiltersPage.mmd>>
  }

  class FilterGroup {
    <<from FiltersPage.mmd>>
  }

  class Watchlist {
    <<from WatchlistPage.mmd>>
  }

  class Order {
    <<from Orders.mmd>>
  }

  class Fill {
    <<from Orders.mmd>>
  }

  class OrderSide {
    <<from Orders.mmd>>
  }

  class OrderType {
    <<from Orders.mmd>>
  }

  class TimeInForce {
    <<from Orders.mmd>>
  }

  class BrokerEnvironment {
    <<from Brokers.mmd>>
  }

  %% ------------------------------------------------------------------ relations

  Automation --> AutomationStatus
  InvestmentPortfolio "1" *-- "*" Budget : budgets
  Budget "*" -- "*" Automation : used by (BudgetAutomation)
  BudgetAutomation ..> Budget
  BudgetAutomation ..> Automation
  Automation "1" *-- "*" AutomationRecord : per budget
  Automation "1" *-- "1..*" FilterRunTarget : runs
  FilterRunTarget "1" --> "1" FilterRunTargetType
  FilterRunTarget ..> Filter : when type is FILTER
  FilterRunTarget ..> FilterGroup : when type is FILTER_GROUP
  Automation "1" *-- "1..*" Schedule : at least one
  Schedule "1" *-- "1" ScheduleState
  Automation "1" *-- "*" ScheduleFire : fired
  Automation "1" *-- "*" AutomationAction : ordered
  Automation "1" *-- "0..1" OrderGuards
  Budget "1" *-- "*" BudgetEntry : ledger
  BudgetEntry --> BudgetEntryType
  BudgetEntry ..> Order : orderId
  BudgetEntry ..> Fill : fillId
  Budget "1" *-- "*" PositionLot : owns shares
  Automation ..> PositionLot : bought
  AutomationAction <|-- NotifyAction
  AutomationAction <|-- AddToWatchlistAction
  AutomationAction <|-- PlaceOrderAction
  AddToWatchlistAction ..> Watchlist : adds matched symbols
  NotifyAction ..> Notification : creates
  PlaceOrderAction "1" *-- "1" SymbolSelection
  PlaceOrderAction "1" *-- "1..*" OrderSizing
  SymbolSelection --> SelectionMode
  SymbolSelection --> RankingKey
  OrderSizing --> OrderSizingMode
  PlaceOrderAction --> OrderSide
  PlaceOrderAction --> OrderType
  PlaceOrderAction --> TimeInForce

  Automation "1" *-- "*" AutomationRun : history
  ScheduleFire "1" --> "1" AutomationRun
  AutomationRun --> RunTrigger
  AutomationRun --> RunStatus
  AutomationRun --> RunSkipReason
  AutomationRun --> BrokerEnvironment
  AutomationRun "1" *-- "1" MarketContext
  MarketContext --> MarketSession
  AutomationRun "1" *-- "*" RunBudget : one per budget
  RunBudget "1" *-- "0..2" BudgetSnapshot : before / after
  ActionResult "1" *-- "*" ActionBudgetResult : one per budget
  AutomationRun "1" *-- "*" TargetResult
  AutomationRun "1" *-- "*" MatchedSymbol
  AutomationRun "1" *-- "*" ActionResult
  AutomationRun "1" *-- "1" RunMetrics
  ActionBudgetResult "1" *-- "*" OrderIntent
  OrderIntent --> IntentDecision
  OrderIntent --> SkipReason
  OrderIntent ..> Order : orderId when placed
  Automation "1" *-- "*" AutomationEvent : audit trail
  AutomationEvent --> AutomationEventType
  Budget "1" *-- "*" PerformanceSnapshot : daily
  AutomationSwitch ..> Automation : pauses all

  %% ------------------------------------------------------------------ rules

  note for Automation "configVersion goes up on every change; each run stores the definition it used.\nOrder actions trade with every budget the automation is in (none: they are skipped).\nMissedPolicy.RUN_ALL is not allowed when any action is a PlaceOrderAction."
  note for Budget "A named pot of the portfolio's cash, shared by its automations: buys take from it,\nsells of its shares put the money back. available() = cash - reserved.\nSum of a portfolio's budgets <= its cash. Every change is a BudgetEntry."
  note for BudgetAutomation "Many-to-many, chosen from the portfolio side. One automation can be in budgets\nof several portfolios; each run plans and places orders per budget."
  note for BudgetEntry "ALLOCATE/WITHDRAW: you move money in/out. RESERVE: buy order placed.\nRELEASE: order cancelled/expired/partly filled. BUY_FILL / SELL_FILL / FEE: from broker fills.\namount is signed; cashAfter/reservedAfter make the history readable without replaying."
  note for ScheduleFire "UNIQUE (automationId, scheduleId, scheduledFor): a time fires once, even after a crash."
  note for AutomationRun "Stored in the shared runs table (kind AUTOMATION), kept 6 months.\nOrders, fills and the budget ledger are kept permanently."
  note for OrderIntent "The plan for one symbol. SELL only from the budget's lots (bought by any of its automations).\nslippage = order averageFillPrice vs estimatedPrice."
  note for PerformanceSnapshot "Written once a day after the close; the series behind gain analysis per budget.\nreturnPercent = (equity - allocated) / allocated."
  note for AutomationSwitch "One switch pauses every automation (runs are recorded as SKIPPED / SWITCH_OFF)."
