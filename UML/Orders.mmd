classDiagram
  class Order {
    - id: string
    - portfolioId: string
    - brokerAccountId: string
    - symbolId: string
    - automationId: string?
    - budgetId: string?
    - automationRunId: string?
    - clientOrderId: string
    - brokerOrderId: string?
    - side: OrderSide
    - type: OrderType
    - timeInForce: TimeInForce
    - quantity: Decimal
    - filledQuantity: Decimal
    - limitPrice: Decimal?
    - stopPrice: Decimal?
    - trailPrice: Decimal?
    - trailPercent: Decimal?
    - extendedHours: bool
    - status: OrderStatus
    - rejectReason: string?
    - averageFillPrice: Decimal?
    - estimatedPrice: Decimal?
    - rawBrokerStatus: string?
    - createdAt: datetime
    - updatedAt: datetime
    - submittedAt: datetime?
    - filledAt: datetime?
    - cancelledAt: datetime?
    - fills: List~Fill~
  }

  class Fill {
    - id: string
    - orderId: string
    - brokerFillId: string
    - quantity: Decimal
    - price: Decimal
    - fee: Decimal
    - realizedPnL: Decimal?
    - executedAt: datetime
  }

  class OrderSide {
    <<enumeration>>
    BUY
    SELL
  }

  class OrderType {
    <<enumeration>>
    MARKET
    LIMIT
    STOP
    STOP_LIMIT
    TRAILING_STOP
  }

  class TimeInForce {
    <<enumeration>>
    DAY
    GTC
    GTD
    OPG
    CLS
    IOC
    FOK
  }

  class OrderStatus {
    <<enumeration>>
    PENDING
    SUBMITTED
    PARTIALLY_FILLED
    FILLED
    CANCELLED
    REJECTED
    EXPIRED
  }

  Order "1" --> "1" OrderSide
  Order "1" --> "1" OrderType
  Order "1" --> "1" TimeInForce
  Order "1" --> "1" OrderStatus
  Order "1" *-- "*" Fill

  note for Order "clientOrderId is unique: resubmitting the same id never creates a second order.\nlimitPrice: LIMIT, STOP_LIMIT. stopPrice: STOP, STOP_LIMIT.\nTRAILING_STOP: exactly one of trailPrice / trailPercent.\nWhich types / time-in-force / extended hours are allowed depends on BrokerCapabilities (Brokers.mmd).\nstatus is normalized by the broker adapter; rawBrokerStatus keeps the broker's own value.\nestimatedPrice comes from the automation's OrderIntent (slippage = averageFillPrice - estimatedPrice).\nOrders and fills are kept permanently."
