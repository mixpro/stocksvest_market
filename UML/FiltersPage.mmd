classDiagram
  class Filter {
    - id: string
    - name: string
    - description: string
    - createdAt: datetime
    - updatedAt: datetime
    - isActive: bool
    - inputs: List~InputTypeIdentifier~
    - actions: List~FilterAction~
  }

  class FilterGroup {
    - id: string
    - name: string
    - description: string
    - createdAt: datetime
    - updatedAt: datetime
    - filters: List~Filter~
  }

  class Run {
    - id: string
    - kind: RunKind
    - subjectId: string
    - ranAt: datetime
    - durationMs: int
    - status: RunStatus
    - definition: json
    - result: json?
    - error: string?
  }

  class RunKind {
    <<enumeration>>
    FILTER
    FILTER_GROUP
    AUTOMATION
  }

  class RunStatus {
    <<enumeration>>
    SUCCEEDED
    FAILED
  }

  class FilterRunResult {
    - steps: List~StepCount~
    - symbols: List~ResultSymbol~
  }

  class ResultSymbol {
    - ticker: string
    - id: string
    - price: Decimal?
    - priceTime: datetime?
    - dailyChangePercent: Decimal?
  }

  class InputType {
    <<enumeration>>
    UNIVERSE
    FILTER
    FILTER_GROUP
    INVESTMENT_PORTFOLIO
    WATCHLIST
    WATCHLIST_GROUP
  }

  class InputTypeIdentifier {
    - id: string?
    - type: InputType
  }

  class FilterAction {
    <<abstract>>
    + filterFunction(symbols: List~string~) List~string~
  }

  class ComparisonCondition {
    <<enumeration>>
    LESS_THAN
    BETWEEN
    MORE_THAN
  }

  class TimePeriodUnit {
    <<enumeration>>
    MINUTES
    HOURS
    DAYS
    WEEKS
    MONTHS
    YEARS
  }

  class AssetType {
    <<enumeration>>
    COMMON_STOCK
    ADR
  }

  class PriceReference {
    <<enumeration>>
    LAST_CLOSE
    LATEST_BAR
  }

  class ValueType {
    <<enumeration>>
    PERCENT
    ABSOLUTE
  }

  class SymbolTypeAction {
    - assetTypes: List~AssetType~
  }

  class SectorAction {
    - sectorIds: List~string~
  }

  class SymbolPriceAction {
    - priceReference: PriceReference
    - condition: ComparisonCondition
    - value: Decimal
    - maxValue: Decimal?
  }

  class PriceChangeAction {
    - periodAmount: int
    - periodUnit: TimePeriodUnit
    - condition: ComparisonCondition
    - valueType: ValueType
    - value: Decimal
    - maxValue: Decimal?
  }

  class PositionAction {
    - portfolioIds: List~string~
  }

  FilterGroup "1" o-- "*" Filter
  Filter "1" *-- "*" InputTypeIdentifier
  Filter "1" --> "*" Run : history (kind FILTER)
  FilterGroup "1" --> "*" Run : history (kind FILTER_GROUP)
  Run --> RunKind
  Run --> RunStatus
  Run ..> FilterRunResult : result
  FilterRunResult "1" *-- "*" ResultSymbol
  InputTypeIdentifier "1" --> "1" InputType
  Filter "1" o-- "*" FilterAction : ordered
  FilterAction <|-- SymbolTypeAction
  FilterAction <|-- SectorAction
  FilterAction <|-- SymbolPriceAction
  FilterAction <|-- PriceChangeAction
  FilterAction <|-- PositionAction
  SymbolTypeAction --> AssetType
  SymbolPriceAction --> PriceReference
  SymbolPriceAction --> ComparisonCondition
  PriceChangeAction --> ComparisonCondition
  PriceChangeAction --> TimePeriodUnit
  PriceChangeAction --> ValueType

  note for Filter "inputs are UNIONED.\nUNIVERSE has no id; every other InputType requires one.\nFILTER / FILTER_GROUP inputs must not form a cycle (validated on save).\nactions run in order; filterFunction is pure.\nFILTER / FILTER_GROUP inputs are re-run live; a group's result is the union of its filters."
  note for ComparisonCondition "LESS_THAN / MORE_THAN are strict. BETWEEN requires maxValue; bounds are inclusive."
  note for PriceChangeAction "MINUTES lookback is limited to the 7 days of minute bars kept."
  note for PositionAction "Keeps symbols with an open position (manual or automation shares) in any selected portfolio."
  note for SectorAction "sectorIds are keys from market GET /v1/sectors (SEC SIC codes mapped to sectors)."
  note for Run "One row per execution of any app action (filters now, automations later).\nKept 6 months (RUN_RETENTION_DAYS) for analysis of gains.\ndefinition = config at run time; result includes prices at run time."
  note for AssetType "Only types in the halal universe (ETFs, preferred, warrants, units, rights are excluded)."
