classDiagram
    %% Conventions (all files): fields camelCase, enum values UPPER_CASE,
    %% money and quantities Decimal, optional fields end with "?".
    %% Entities carry id, createdAt, updatedAt.

    class InvestmentPortfolio {
      - id: string
      - name: string
      - description: string
      - createdAt: datetime
      - updatedAt: datetime
      - brokerAccountId: string
      - allocated: Decimal
      - cash: Decimal
      - currency: string
      - positions: List~Position~
      - budgets: List~Budget~
      - orders: List~Order~
      + availableCash() Decimal
      + unallocatedCash() Decimal
    }

    class Position {
      - id: string
      - portfolioId: string
      - symbolId: string
      - quantity: Decimal
      - averageCost: Decimal
      - realizedPnL: Decimal
      - openedAt: datetime
      - updatedAt: datetime
      + marketValue(lastPrice: Decimal) Decimal
      + unrealizedPnL(lastPrice: Decimal) Decimal
    }

    class PortfolioEntry {
      - id: string
      - portfolioId: string
      - type: PortfolioEntryType
      - amount: Decimal
      - cashAfter: Decimal
      - automationId: string?
      - budgetId: string?
      - orderId: string?
      - fillId: string?
      - note: string?
      - createdAt: datetime
    }

    class PortfolioEntryType {
      <<enumeration>>
      ALLOCATE
      WITHDRAW
      BUY_FILL
      SELL_FILL
      FEE
      ADJUSTMENT
    }

    class PortfolioSnapshot {
      - portfolioId: string
      - at: datetime
      - kind: SnapshotKind
      - allocated: Decimal
      - cash: Decimal
      - unallocated: Decimal
      - invested: Decimal
      - positionsValue: Decimal
      - equity: Decimal
      - realizedPnL: Decimal
      - unrealizedPnL: Decimal
    }

    class SnapshotKind {
      <<enumeration>>
      INTERVAL
      CLOSE
      MANUAL
    }

    class PositionLot {
      - id: string
      - positionId: string
      - budgetId: string?
      - automationId: string?
      - buyFillId: string
      - quantity: Decimal
      - remainingQuantity: Decimal
      - costPerShare: Decimal
      - openedAt: datetime
      - closedAt: datetime?
      - realizedPnL: Decimal
    }

    class Order {
      <<from Orders.mmd>>
    }

    class BrokerAccount {
      <<from Brokers.mmd>>
    }

    class Fill {
      <<from Orders.mmd>>
    }

    class Automation {
      <<from Automations.mmd>>
    }

    class Budget {
      <<from Automations.mmd>>
    }

    InvestmentPortfolio "1" *-- "*" Position : holds
    Position "1" *-- "*" PositionLot : bought in lots
    InvestmentPortfolio "*" --> "1" BrokerAccount : capital carved from
    InvestmentPortfolio "1" *-- "*" PortfolioEntry : cash ledger
    PortfolioEntry --> PortfolioEntryType
    InvestmentPortfolio "1" *-- "*" PortfolioSnapshot : history
    PortfolioSnapshot --> SnapshotKind
    InvestmentPortfolio "1" *-- "*" Order : places
    Order "1" *-- "*" Fill
    Fill ..> Position : updates quantity, averageCost, realizedPnL
    InvestmentPortfolio "1" *-- "*" Budget : carved from its cash
    Budget "*" -- "*" Automation : used by
    Budget "1" o-- "*" PositionLot : owns

    note for InvestmentPortfolio "A broker account holds several portfolios; each gets capital from the account's\nunassigned cash. cash = its own ledger (capital, fills, fees), not the broker's cash.\navailableCash() = cash minus open manual buys. unallocatedCash() = availableCash() minus its budgets' cash."
    note for PortfolioSnapshot "Every 15 min of the regular session (INTERVAL), after each close (CLOSE), or on request."
    note for Position "One position per (portfolioId, symbolId).\nMaintained from fills, not by replaying orders.\nquantity 0 = closed, kept for realizedPnL history.\nunrealizedPnL is calculated from the synced price, never stored."
    note for PositionLot "Each buy fill opens a lot owned by the budget that paid (null = manual shares) and tagged\nwith the automation that bought it. Sells close the budget's lots FIFO, whoever bought them,\nso money and P&L are exact per budget."
