    {
      "id": 8,
      "type": "table",
      "title": "Latest daily change (all halal symbols)",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stocksvest-market"
      },
      "gridPos": {
        "h": 12,
        "w": 14,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stocksvest-market"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "WITH d AS (\n  SELECT symbol_id, ts, c, v, ROW_NUMBER() OVER (PARTITION BY symbol_id ORDER BY ts DESC) AS rn\n  FROM bars_1day\n)\nSELECT s.ticker AS Ticker, s.name AS Name, s.exchange AS Exchange,\n       date(cur.ts, 'unixepoch') AS Date, cur.c AS Close, prev.c AS \"Previous close\",\n       ROUND((cur.c - prev.c) / prev.c * 100, 2) AS \"Change %\", cur.v AS Volume\nFROM symbols s\nJOIN d cur  ON cur.symbol_id = s.id AND cur.rn = 1\nJOIN d prev ON prev.symbol_id = s.id AND prev.rn = 2\nORDER BY \"Change %\" DESC",
          "queryText": "WITH d AS (\n  SELECT symbol_id, ts, c, v, ROW_NUMBER() OVER (PARTITION BY symbol_id ORDER BY ts DESC) AS rn\n  FROM bars_1day\n)\nSELECT s.ticker AS Ticker, s.name AS Name, s.exchange AS Exchange,\n       date(cur.ts, 'unixepoch') AS Date, cur.c AS Close, prev.c AS \"Previous close\",\n       ROUND((cur.c - prev.c) / prev.c * 100, 2) AS \"Change %\", cur.v AS Volume\nFROM symbols s\nJOIN d cur  ON cur.symbol_id = s.id AND cur.rn = 1\nJOIN d prev ON prev.symbol_id = s.id AND prev.rn = 2\nORDER BY \"Change %\" DESC",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Change %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
