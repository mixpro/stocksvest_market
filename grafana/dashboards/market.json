    {
      "id": 9,
      "type": "table",
      "title": "Data coverage per symbol (fewest minute bars first)",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stocksvest-market"
      },
      "gridPos": {
        "h": 12,
        "w": 10,
        "x": 14,
        "y": 18
