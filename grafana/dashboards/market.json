      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stocksvest-market"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT s.ticker AS Ticker,\n  (SELECT COUNT(*) FROM bars_1day  WHERE symbol_id = s.id) AS \"Daily bars\",\n  (SELECT COUNT(*) FROM bars_1hour WHERE symbol_id = s.id) AS \"Hourly bars\",\n  (SELECT COUNT(*) FROM bars_1min  WHERE symbol_id = s.id) AS \"Minute bars\",\n  (SELECT strftime('%Y-%m-%dT%H:%M:%SZ', MAX(ts), 'unixepoch') FROM bars_1min WHERE symbol_id = s.id) AS \"Latest minute bar\"\nFROM symbols s ORDER BY \"Minute bars\" ASC",
          "queryText": "SELECT s.ticker AS Ticker,\n  (SELECT COUNT(*) FROM bars_1day  WHERE symbol_id = s.id) AS \"Daily bars\",\n  (SELECT COUNT(*) FROM bars_1hour WHERE symbol_id = s.id) AS \"Hourly bars\",\n  (SELECT COUNT(*) FROM bars_1min  WHERE symbol_id = s.id) AS \"Minute bars\",\n  (SELECT strftime('%Y-%m-%dT%H:%M:%SZ', MAX(ts), 'unixepoch') FROM bars_1min WHERE symbol_id = s.id) AS \"Latest minute bar\"\nFROM symbols s ORDER BY \"Minute bars\" ASC",
          "timeColumns": []
        }
