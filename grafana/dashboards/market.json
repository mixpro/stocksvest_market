    {
      "id": 7,
      "type": "candlestick",
      "title": "${symbol} \u00b7 ${table:text}",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stocksvest-market"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stocksvest-market"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT strftime('%Y-%m-%dT%H:%M:%SZ', b.ts, 'unixepoch') AS time,\n       b.o AS open, b.h AS high, b.l AS low, b.c AS close, b.v AS volume\nFROM ${table} b JOIN symbols s ON s.id = b.symbol_id\nWHERE s.ticker = '${symbol}'\n  AND b.ts >= ${__from:date:seconds} AND b.ts <= ${__to:date:seconds}\nORDER BY b.ts",
          "queryText": "SELECT strftime('%Y-%m-%dT%H:%M:%SZ', b.ts, 'unixepoch') AS time,\n       b.o AS open, b.h AS high, b.l AS low, b.c AS close, b.v AS volume\nFROM ${table} b JOIN symbols s ON s.id = b.symbol_id\nWHERE s.ticker = '${symbol}'\n  AND b.ts >= ${__from:date:seconds} AND b.ts <= ${__to:date:seconds}\nORDER BY b.ts",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "up": "green",
          "down": "red"
        },
        "includeAllFields": false,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
